---
---

<section class="py-20 sm:py-24 bg-brand-dark">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative bg-brand-charcoal rounded-2xl border border-white/5 p-8 sm:p-12 overflow-hidden">
      <!-- Subtle accent -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-academy-teal to-emerald-400"></div>

      <div class="text-center">
        <!-- Shield icon -->
        <div class="inline-flex items-center justify-center w-16 h-16 bg-academy-teal/10 rounded-2xl mb-6">
          <svg class="w-8 h-8 text-academy-teal" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M9.661 2.237a.531.531 0 01.678 0 11.947 11.947 0 007.078 2.749.5.5 0 01.479.425c.069.52.104 1.05.104 1.59 0 5.162-3.26 9.563-7.834 11.256a.48.48 0 01-.332 0C5.26 16.564 2 12.163 2 7c0-.538.035-1.069.104-1.589a.5.5 0 01.48-.425 11.947 11.947 0 007.077-2.75z" clip-rule="evenodd" />
          </svg>
        </div>

        <h2 class="text-3xl sm:text-4xl font-black text-white mb-4">
          We've Never Met a Dog We Can't Work With
        </h2>
        <p class="text-lg text-neutral-400 max-w-2xl mx-auto mb-8 leading-relaxed">
          Reactive. Nervous. Aggressive. Kicked out of other daycares. High-energy with zero impulse control. We've handled every scenario in 15 years — and we've never turned a dog away. Your dog isn't "too much." They just haven't been managed by the right people yet.
        </p>

        <!-- Proof points -->
        <div class="grid sm:grid-cols-3 gap-6 mb-10">
          <div class="bg-white/5 rounded-xl p-5">
            <p class="text-2xl font-black text-white mb-1">15 <span class="text-academy-teal">Years</span></p>
            <p class="text-sm text-neutral-400">Zero safety incidents</p>
          </div>
          <div class="bg-white/5 rounded-xl p-5">
            <p class="text-2xl font-black text-white mb-1">Every <span class="text-academy-teal">Breed</span></p>
            <p class="text-sm text-neutral-400">Every temperament, every size</p>
          </div>
          <div class="bg-white/5 rounded-xl p-5">
            <p class="text-2xl font-black text-white mb-1">No <span class="text-academy-teal">Fees</span></p>
            <p class="text-sm text-neutral-400">Free phone assessment, no registration cost</p>
          </div>
        </div>

        <a href="#contact" class="inline-flex items-center px-8 py-4 bg-academy-teal text-white text-base font-bold rounded-xl hover:bg-academy-teal-dark transition-all duration-200 shadow-lg shadow-academy-teal/25 hover:shadow-academy-teal/40 hover:-translate-y-0.5">
          Book Your Phone Assessment
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
